node_modules/

# Regenerable derivations — rebuild with the scripts, don't version the bytes
pipeline/cache/
pipeline/out/*.bin
prototype/data/
prototype/*.jpg
prototype/*.png
prototype/tidemap-*.html

# Large source rasters: kept on disk under sources/, provenance committed instead.
# See docs/SOURCES.md — every one is reproducible from the recorded parameters.
sources/**/*.png
sources/**/*.tif

# The packaged iPad app is a build artifact of build-ipad.mjs
prototype/ipad/

# Overnight-round research images are regenerable from the scripts beside them
research/overnight-*/**/*.png
research/overnight-*/**/*.jpg

# API keys live here — never commit
.env
